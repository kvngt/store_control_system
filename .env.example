# Configuración de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxx

# Sentry DSN para monitoreo de errores (Opcional en desarrollo)
VITE_SENTRY_DSN=https://xxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx

# Dominio público desde el que se sirve la app. Se usa para construir el enlace
# de "restablecer contraseña" que llega por correo. Si no se define, se usa el
# origen actual del navegador — lo que en desarrollo genera enlaces a
# http://localhost:PUERTO que no abren desde ningún otro lado.
# Debe coincidir exactamente con una de las Redirect URLs del panel de Supabase.
VITE_PUBLIC_SITE_URL=https://reinventa.shop

# Llave PÚBLICA VAPID para notificaciones push. Es pública por diseño (el
# navegador la necesita para suscribirse); la privada va solo en los secretos de
# las edge functions. Se generan juntas — ver docs/deployment.md. Sin esta
# variable la app funciona igual, sin push.
VITE_VAPID_PUBLIC_KEY=
