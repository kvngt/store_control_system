{
  "name": "restorify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de administración de talleres mecánicos y de pintura",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "db:check": "node scripts/check-migrations.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^10.73.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/react-signature-canvas": "^1.0.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.2",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
