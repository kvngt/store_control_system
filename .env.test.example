# Copy to .env.test.local (gitignored, matches *.local) and fill in real
# credentials to run the Playwright tests that need a logged-in session.
# Tests that don't need a session (e.g. the invalid-login check) always run.
#
# IMPORTANT: these tests run against whatever Supabase project VITE_SUPABASE_URL
# in .env.local points to. There's no separate staging project yet, so tests
# that create data (see e2e/customer-crud.spec.ts) tag everything they create
# with a "PWTEST" prefix and delete it again at the end.

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional — only needed for the role-permission tests in e2e/login.spec.ts.
E2E_MECHANIC_EMAIL=
E2E_MECHANIC_PASSWORD=

# Optional — the extra accounts used by the role tests (painter, and an admin
# on a second sede). Without them those specs skip themselves.
E2E_PAINTER_EMAIL=
E2E_PAINTER_PASSWORD=
E2E_BRANCH_ADMIN_EMAIL=
E2E_BRANCH_ADMIN_PASSWORD=

# Optional — defaults to http://localhost:5173, and that is where it should stay.
# The suite writes to the real Supabase project either way; pointing it at the
# published site means a routine test run drives production. playwright.config.ts
# refuses a non-local value unless E2E_ALLOW_REMOTE=1 is also set.
# E2E_BASE_URL=http://localhost:5173
